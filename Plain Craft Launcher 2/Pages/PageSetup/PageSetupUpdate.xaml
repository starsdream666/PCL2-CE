<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageSetupUpdate"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <local:MyCard>
                <StackPanel Margin="20,20,20,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="29" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Image Source="pack://application:,,,/Images/icon.png" Grid.Column="0" Grid.Row="0"
                               Grid.RowSpan="3" Height="50" Width="50" HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                        <TextBlock x:Name="TextCurrentVersion" Text="PCL CE" FontWeight="Bold" FontSize="20"
                                   Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <TextBlock x:Name="TextCurrentDesc" Text="{DynamicResource Setup.Update.Offline.Desc}"
                                   FontSize="14" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left"
                                   VerticalAlignment="Top" TextWrapping="Wrap" />
                        <TextBlock x:Name="TextVersionCode" Text="{DynamicResource Setup.Update.Offline.VersionCode}"
                                   FontSize="13" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Left"
                                   VerticalAlignment="Top" TextWrapping="Wrap" Opacity="0.7" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="{DynamicResource Setup.Update.Offline.Title}" Margin="0,15">
                <StackPanel Margin="20,20,20,20">
                    <TextBlock x:Name="TextOfflineNote" Text="{DynamicResource Setup.Update.Offline.Note}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
